{"saveVersion":17,"width":9,"height":9,"mapStats":{"name":"Personal Modded Template","description":"Known World Names:\n\nSanctum of Souls\nSanctum and Souls\nMemory of Soup\nSun and Place\nWorld and Clouds\nPerfected Land\nMadnes and Life\nMoon and Madness\nGod's Realm\nMemory of Madness\nWizardry and Dragons\n________________________________________\nKnown Architect Names:\n\nThe Smart","player_name":"The Smart","player_mood":"serene","custom_data":{"custom_data_string":{"ce_world_id":"1d727bd52fe4","the_codex.book.v1":"{\"version\":2,\"world_name\":\"Personal Modded Template\",\"started_year\":1,\"started_late\":false,\"mode\":\"ages\",\"chapters\":[{\"era_id\":\"age_hope\",\"history_lost\":-1,\"custom\":false,\"title\":\"The Age of Hope\",\"intro\":\"Ysa the Singer, a wandering bard, sets down in plain ink what is usually sung. Imagine the music; it was very good. Here begins the Age of Hope. From the year 1 the rains came when they were wanted and the winters were short, and the peoples of Personal Template began to believe that the gods had at last turned their faces toward them.\",\"chronicler\":\"Ysa the Singer\",\"chronicler_title\":\"a wandering bard\",\"writers\":[{\"name\":\"Ysa the Singer\",\"voice\":\"bard\",\"title\":\"a wandering bard\",\"since\":1}],\"voice\":\"bard\",\"start_year\":1,\"end_year\":-1,\"entries\":[],\"unrecorded\":{},\"filtered\":{},\"war_dead\":{}}],\"last_variant\":{\"opening.bard\":1,\"intro.age_hope\":1},\"recent\":{\"opening.bard\":[1],\"intro.age_hope\":[1]},\"last_scenario\":{},\"era_counts\":{\"age_hope\":1},\"realms\":{},\"rivalries\":{},\"wars\":{},\"war_stories\":{},\"chronicler\":{\"name\":\"Ysa the Singer\",\"voice\":\"bard\",\"title\":\"a wandering bard\",\"since\":1},\"chronicler_locked\":false,\"people\":{},\"followed\":{},\"journals\":[],\"journal_declined\":[],\"library\":[],\"library_enabled\":true,\"atlas_regions\":[],\"atlas_pins\":[],\"atlas_shown\":true,\"muted\":[],\"min_weight\":0.0,\"entry_limit\":4000,\"follow_rulers\":true,\"legends_enabled\":true,\"legend_age\":3,\"famines\":{},\"records\":{},\"battle_places\":{}}"}},"world_time":18.049999417737126,"world_age_id":"age_hope","world_age_started_at":15.769999468699098,"same_world_age_started_at":15.769999468699098,"current_world_ages_duration":2520.0,"is_world_ages_paused":true,"world_ages_slots":["age_hope","age_hope","age_hope","age_hope","age_hope","age_hope","age_hope","age_hope"],"creaturesCreated":1045,"subspeciesCreated":2,"subspeciesExtinct":2,"familiesCreated":1,"familiesDestroyed":1,"id_unit":4351,"id_building":3,"id_status":8810,"id_subspecies":3,"id_family":2,"life_dna":2025041714,"deaths":4350,"deaths_fire":4337,"deaths_smile":13},"deaths":4350,"modded":true,"modsActive":["NeoModLoader"],"timestamp":1794608810.1810243}