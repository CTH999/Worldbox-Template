{"saveVersion":17,"width":9,"height":9,"mapStats":{"name":"Personal Modded Template","description":"Known World Names:\n\nSanctum of Souls\nSanctum and Souls\nMemory of Soup\nSun and Place\nWorld and Clouds\nPerfected Land\nMadnes and Life\nMoon and Madness\nGod's Realm\nMemory of Madness\nWizardry and Dragons\n________________________________________\nKnown Architect Names:\n\nThe Smart","player_name":"The Smart","player_mood":"serene","custom_data":{"custom_data_string":{"ce_world_id":"1d727bd52fe4","the_codex.book.v1":"{\"version\":2,\"world_name\":\"Personal Modded Template\",\"started_year\":1,\"started_late\":false,\"mode\":\"ages\",\"chapters\":[{\"era_id\":\"age_hope\",\"history_lost\":-1,\"custom\":false,\"title\":\"The Age of Hope\",\"intro\":\"Dame Rosamund Ashe, historian to the court, begins this chronicle. The reader is warned that the truth has been told wherever it was safe, and implied wherever it was not. The year 1 is remembered as a dawn. The fields of Personal Modded Template grew green, the cradles filled, and even the oldest grudges seemed for a time too heavy to carry. So began the Age of Hope, which the scribes, knowing the world, did not expect to keep.\",\"chronicler\":\"Dame Rosamund Ashe\",\"chronicler_title\":\"historian to the court\",\"writers\":[{\"name\":\"Dame Rosamund Ashe\",\"voice\":\"courtier\",\"title\":\"historian to the court\",\"since\":1}],\"voice\":\"courtier\",\"start_year\":1,\"end_year\":-1,\"entries\":[],\"unrecorded\":{},\"filtered\":{},\"war_dead\":{}}],\"last_variant\":{\"opening.courtier\":1,\"intro.age_hope\":2},\"recent\":{\"opening.courtier\":[1],\"intro.age_hope\":[2]},\"last_scenario\":{},\"era_counts\":{\"age_hope\":1},\"realms\":{},\"rivalries\":{},\"wars\":{},\"war_stories\":{},\"chronicler\":{\"name\":\"Dame Rosamund Ashe\",\"voice\":\"courtier\",\"title\":\"historian to the court\",\"since\":1},\"chronicler_locked\":false,\"people\":{},\"followed\":{},\"journals\":[],\"journal_declined\":[],\"library\":[