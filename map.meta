{"saveVersion":17,"width":9,"height":9,"mapStats":{"name":"Test","description":"Known World Names:\n\nSanctum of Souls\nSanctum and Souls\nMemory of Soup\nSun and Place\nWorld and Clouds\nPerfected Land\nMadnes and Life\nMoon and Madness\nGod's Realm\nMemory of Madness\nWizardry and Dragons\n________________________________________\nKnown Architect Names:\n\nThe Smart","player_name":"The Smart","player_mood":"serene","custom_data":{"custom_data_string":{"ce_world_id":"f2e8ff268bf7","the_codex.book.v1":"{\"version\":2,\"world_name\":\"Test\",\"started_year\":1,\"started_late\":false,\"mode\":\"ages\",\"chapters\":[{\"era_id\":\"age_hope\",\"history_lost\":-1,\"custom\":false,\"title\":\"The Age of Hope\",\"intro\":\"These annals of Personal Template are kept by Lady Isembard, historian to the court, who has served many rulers and believed very few of them. In the year 1 the skies of Personal Template cleared and a mild light lay upon the land. The old songs call this the Age of Hope, when harvests were heavy and every road seemed to lead somewhere worth going. The chroniclers who lived through it wrote quickly, as if they feared it would not last.\",\"chronicler\":\"Lady Isembard\",\"chronicler_title\":\"historian to the court\",\"writers\":[{\"name\":\"Lady Isembard\",\"voice\":\"courtier\",\"title\":\"historian to the court\",\"since\":1}],\"voice\":\"courtier\",\"start_year\":1,\"end_year\":-1,\"entries\":[],\"unrecorded\":{},\"filtered\":{},\"war_dead\":{}}],\"last_variant\":{\"opening.courtier\":0,\"intro.age_hope\":0},\"recent\":{\"opening.courtier\":[0],\"intro.age_hope\":[0]},\"last_scenario\":{},\"era_counts\":{\"age_hope\":1},\"realms\":{},\"rivalries\":{},\"wars\":{},\"war_stories\":{},\"chronicler\":{\"name\":\"Lady Isembard\",\"voice\":\"courtier\",\"title\":\"historian to the court\",\"since\":1},\"chronicler_locked\":false,\"people\":{},\"followed\":{},\"journals\":[],\"journal_declined\":[],\"library\":[],\"library_enabled\":true,\"atlas_regions\":[],